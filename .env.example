# EVIDIQ Axiom MCP — environment template.
# Copy to .env (or the VPS env file) and fill in. Never commit real values.

# --- server ---
PORT=3022
HOSTNAME=0.0.0.0
PUBLIC_BASE_URL=https://mcp.evidiq.dev/axiom

# --- signer (no fallback; unset -> signing tools refuse) ---
# Bare 64-hex or 0x-prefixed 32-byte private key. Derives the fleet signer.
AXIOM_SIGNER_PRIVATE_KEY=

# --- store ---
AXIOM_DB_PATH=/data/axiom.db
# How long a stored on-chain observation is reused before re-reading.
AXIOM_OBSERVATION_TTL_SEC=3600

# --- on-chain reads ---
# onchainos binary (not on PATH even for login shells — always absolute).
ONCHAINOS_BIN=/root/.local/bin/onchainos

# --- verify_claim model (optional; without it, verdicts are mechanical) ---
AXIOM_CLAIM_MODEL=
AXIOM_CLAIM_MODEL_URL=
AXIOM_CLAIM_MODEL_KEY=

# --- x402 ---
# Phase 1: 1 bypasses the gate (paid tools answer 200). Phase 2: delete the line.
AXIOM_X402_BYPASS=1
X402_PAY_TO=
OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# --- 0G Storage anchoring (best effort — every attestation receipt) ---
OG_PRIVATE_KEY=
OG_STORAGE_RPC=https://evmrpc.0g.ai
OG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
OG_CHAIN_ID=16661
OG_COMPUTE_RPC=https://evmrpc.0g.ai

# --- node ---
NODE_ENV=production
